<%# Barra horizontal de un solo tono. El ancho va como atributo SVG porque la CSP no admite estilos en línea. %>
<% const pct = max > 0 ? Math.max(value > 0 ? 2 : 0, Math.round(value / max * 1000) / 10) : 0; %>
<svg class="bar" role="presentation" aria-hidden="true" focusable="false"><title><%= label %>: <%= value %></title><rect class="bar-track" width="100%" height="100%" rx="4"></rect><% if (pct) { %><rect class="bar-fill" width="<%= pct %>%" height="100%" rx="4"></rect><% } %></svg>
