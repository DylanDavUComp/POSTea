<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#2A1150">
  <title><%= title %></title>
  <%- include('favicon') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Questrial&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v=20261007-3">
  <link rel="stylesheet" href="/css/catalogos.css">
</head>
<body>
  <a class="skip-link" href="#contenido">Ir al contenido</a>
  <header class="site-header">
    <div class="container header-inner">
      <div class="brand-group">
        <img class="brand-u" src="/img/ucompensar/ucompensar-blanco.png" alt="UCompensar" width="794" height="218">
        <a class="brand" href="/" aria-label="POSTEA, inicio"><strong>POSTEA.</strong><span> / tu <b>ART</b>ículo</span></a>
      </div>
      <nav class="header-nav" aria-label="Cuenta">
        <a class="nav-home" href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 4l9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>Inicio</a>
        <a href="/muro">Explorar</a>
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.estado === 'activo' && (user.rol === 'autor' || user.rol === 'admin')) { %><a href="/panel">Mis fichas</a><% } %>
          <% if (user.estado === 'activo' && ['coordinador','admin'].includes(user.rol)) { %><a href="/coordinacion">Coordinación</a><% } %>
          <% if (user.estado === 'activo' && user.rol === 'admin') { %><a href="/admin">Admin IMAGO</a><% } %>
          <a href="/mi-cuenta">Mi cuenta</a>
          <form class="nav-logout" action="/salir" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit">Salir</button></form>
        <% } else { %>
          <a href="/ingresar">Ingresar</a>
          <a class="nav-register" href="/registro">Crear cuenta</a>
        <% } %>
      </nav>
    </div>
  </header>
