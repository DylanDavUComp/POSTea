<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %></title>
  <%- include('partials/favicon') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Questrial&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v=20261009-2">
  <link rel="stylesheet" href="/css/catalogos.css">
</head>
<body class="print-doc">
  <header class="print-toolbar">
    <a class="back-link" href="<%= back %>">← Volver</a>
    <div>
      <h1><%= pieces.length === 1 ? 'Pieza imprimible' : `Lote de ${pieces.length} piezas` %></h1>
      <p class="preview-warning">Imagen de referencia. Diseño sujeto a ajustes. Haz una prueba de impresión antes de producir todas las piezas.</p>
      <p class="muted">Medio pliego vertical (50 × 70 cm). En el diálogo de impresión elige <strong>Guardar como PDF</strong>, márgenes <strong>Ninguno</strong>, escala <strong>100 %</strong> y activa <strong>Gráficos de fondo</strong>.</p>
      <% const blocked = pieces.filter(p => p.provisional); if (blocked.length) { %>
        <p class="form-alert" role="alert"><strong>QR PROVISIONAL – NO IMPRIMIR.</strong> <%= blocked.length === pieces.length ? 'Estas piezas' : `${blocked.length} de ${pieces.length} piezas` %> no están listas: <%= [...new Set(blocked.map(p => p.provisional))].join('; ') %>.</p>
      <% } %>
    </div>
    <div class="print-actions">
      <button class="button" type="button" data-print>Imprimir / Guardar como PDF</button>
      <% if (pieces.length === 1) { const p = pieces[0]; %>
        <a class="button secondary-button" href="<%= p.url %>" target="_blank" rel="noopener">Probar QR</a>
        <a class="text-link-dark" href="/investigaciones/<%= p.id %>/qr.png?descargar=1">QR en PNG</a>
        <a class="text-link-dark" href="/investigaciones/<%= p.id %>/qr.svg?descargar=1">QR en SVG</a>
      <% } %>
    </div>
  </header>
  <main class="sheets">
    <% for (const p of pieces) { %>
      <%# Rótulo solo en pantalla (no se imprime): territorio y título, para ubicar la pieza en el vidrio. -%>
      <p class="sheet-caption"><% if (p.territorio) { %><span class="territory-tag ter-<%= p.territorio_id %>"><%= p.territorio %></span><% } %><span><%= p.programa %></span></p>
      <article class="sheet sheet-post-only" aria-label="Pieza: <%= p.titulo %>">
        <% if (p.provisional) { %><div class="sheet-watermark" aria-hidden="true">QR PROVISIONAL – NO IMPRIMIR</div><% } %>
        <%- include('partials/post', { post: {
          titulo: p.titulo, frase: p.pregunta_gancho, facultad: p.facultad, programa: p.programa, facultadId: p.facultad_id, territorioId: p.territorio_id,
          investigadores: p.investigadores, headingTag: 'h2', imageSrc: p.tiene_imagen ? `/media/investigaciones/${p.id}` : null,
          imageAlt: 'Imagen de la investigación', qrSvg: p.qr, provisional: Boolean(p.provisional) } }) %>
      </article>
    <% } %>
  </main>
  <script src="/js/form.js?v=20261009-3" defer></script>
</body>
</html>
