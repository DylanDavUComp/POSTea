<%- include('partials/head', { title }) %>
<main id="contenido" class="container section preview-page">
  <a class="back-link" href="<%= typeof backUrl !== 'undefined' ? backUrl : '/panel' %>">← Volver al panel</a>
  <% if (resultado === 'guardada') { %><div class="success-note" role="status">La ficha quedó guardada. Puedes seguir editándola desde tu panel.</div><% } %>
  <% if (resultado === 'cambios-guardados') { %><div class="success-note" role="status">Tus cambios quedaron guardados sin enviar. La ficha pública sigue igual.</div><% } %>
  <% if (resultado === 'cambios-enviados') { %><div class="success-note" role="status">Tus cambios fueron enviados a IMAGO. La ficha pública sigue igual hasta que los aprueben.</div><% } %>
  <% if (research.estado_flujo === 'publicada' && research.edicion_autorizada_at && String(research.autor_id) === String(user.id)) { %>
    <p class="status-note">IMAGO autorizó editar esta ficha publicada. <% if (research.cambios_estado === 'enviada') { %>Tus cambios están en revisión.<% } else if (research.cambios_estado === 'devuelta') { %>IMAGO te devolvió los cambios con observaciones: <%= research.cambios_observaciones %><% } %> <a href="/panel/investigaciones/<%= research.id %>/editar">Editar ficha</a></p>
  <% } %>
  <% if (resultado === 'enviada') { %><div class="success-note" role="status">La ficha fue enviada para revisión. Puedes consultar su estado desde tu panel.</div><% } %>
  <p class="eyebrow">Vista previa · <%= research.estado_flujo %></p>
  <h1><%= research.titulo %></h1>
  <% if (research.estado_flujo === 'publicada') { %><p><a class="button" href="/f/<%= research.slug %>">Ver ficha pública</a></p><% } %>
  <% if (typeof changed !== 'undefined') { %><p class="status-note"><strong>Cambios propuestos por el autor:</strong> <%= changed.length ? changed.join(', ') : 'ninguno respecto a la versión publicada' %>. Esta vista muestra cómo quedará la ficha al aprobarlos; apruébalos o devuélvelos desde Publicación.</p><% } %>
  <p class="preview-warning">Imagen de referencia. Diseño sujeto a ajustes. Haz una prueba de impresión antes de producir piezas.</p>
  <div class="preview-actions"><% if (canEdit) { %><a class="button" href="/panel/investigaciones/<%= research.id %>/editar">Editar ficha</a><% } %>
    <% if (canEdit && ['borrador','devuelta'].includes(research.estado_flujo) && String(research.autor_id) === String(user.id)) { %>
      <form method="post" action="/panel/investigaciones/<%= research.id %>/eliminar" data-confirm="¿Eliminar este borrador?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button" type="submit">Eliminar borrador</button></form>
    <% } %>
  </div>
  <div class="preview-actions qr-actions">
    <a class="button secondary-button" href="/investigaciones/<%= research.id %>/pieza">Ver pieza imprimible (50 × 70 cm)</a>
    <a class="text-link-dark" href="/investigaciones/<%= research.id %>/qr.png?descargar=1">Descargar QR (PNG)</a>
    <a class="text-link-dark" href="/investigaciones/<%= research.id %>/qr.svg?descargar=1">Descargar QR (SVG)</a>
  </div>
  <% if (research.estado_flujo !== 'publicada') { %><p class="status-note">El QR queda marcado como provisional hasta que IMAGO publique la ficha: antes de eso su enlace todavía puede cambiar.</p><% } %>
  <div class="preview-grid">
    <%- include('partials/post', { post: {
      titulo: research.titulo, facultad: research.facultad_nombre, programa: research.programa_nombre, headingTag: 'h2',
      investigadores: research.investigadores ? research.investigadores.split('\n') : [],
      imageSrc: research.imagen ? (typeof imageSrc !== 'undefined' && imageSrc ? imageSrc : `/media/investigaciones/${research.id}`) : null,
      imageAlt: `Imagen de ${research.titulo}`, qrSrc: `/investigaciones/${research.id}/qr.svg` } }) %>
    <article class="fiche-preview">
      <p class="eyebrow">Ficha de investigación</p><h2><%= research.titulo %></h2>
      <% if (research.subtitulo) { %><p class="subtitle"><%= research.subtitulo %></p><% } %>
      <p><strong><%= research.facultad_nombre %></strong> · <%= research.programa_nombre %></p>
      <p><strong>Investigadores:</strong> <%= research.investigadores ? research.investigadores.split('\n').join(' · ') : 'Pendiente' %></p>
      <% [['01','Descripción','descripcion'],['02','Objetivo','objetivo'],['03','Metodología','metodologia'],['04','Resultados','resultados']].forEach(section => { %>
        <section class="fiche-section"><span><%= section[0] %></span><h3><%= section[1] %></h3><p><%= research[section[2]] || 'Pendiente por completar.' %></p></section>
      <% }) %>
      <% if (research.sharepoint_url) { %><p><a href="<%= research.sharepoint_url %>" target="_blank" rel="noopener noreferrer">Ver ficha en PDF (SharePoint)</a></p><% } %>
      <p class="preview-warning">Esta vista es privada. La ficha pública estará disponible cuando IMAGO la publique.</p>
    </article>
  </div>
  <script src="/js/form.js" defer></script>
</main>
<%- include('partials/footer') %>
