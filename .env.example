# Copia este archivo a .env (nunca subas .env al repositorio).
# En Render estas variables se configuran desde el Blueprint (render.yaml) y el panel Environment.

# Conexión PostgreSQL. En local apunta al contenedor de compose.yml (npm run db:up, puerto 15432).
# En Render la enlaza el Blueprint (Internal Database URL).
DATABASE_URL=postgresql://postea:postea@127.0.0.1:15432/postea
# SSL hacia la base: true | false. Vacío = usa ?sslmode= de la URL si existe; si no, SSL solo con NODE_ENV=production.
DB_SSL=
# true = valida el certificado del servidor (por defecto no).
DB_SSL_REJECT_UNAUTHORIZED=
# Conexiones máximas del pool (por defecto 5, tope 20).
DB_POOL_MAX=
# Reintentos de conexión al migrar si la base aún no está lista (por defecto 10, espera 1, 2, 4… hasta 30 s).
DB_CONNECT_RETRIES=
# Espera base entre reintentos en milisegundos (por defecto 1000). Solo se cambia en pruebas.
DB_RETRY_BASE_MS=
# Base Free de Render: fecha de vencimiento (AAAA-MM-DD, Render → postea-db). El tablero admin avisa los días que faltan.
DB_EXPIRA_EN=
# Días de margen tras la exhibición para exportar datos antes del vencimiento (por defecto 3).
DB_MARGEN_EXPORTAR_DIAS=
# Límite de almacenamiento de la base en MB (por defecto 1024, plan Free). El tablero alerta al pasar del 70 %.
DB_LIMITE_MB=

# Proxy. TRUST_PROXY: saltos de proxy de confianza (por defecto 1 en producción, para detectar HTTPS).
TRUST_PROXY=
# Cabecera con la IP real del visitante. En Render: cf-connecting-ip (la escribe Cloudflare). Vacío = req.ip.
CLIENT_IP_HEADER=

# Cadena aleatoria de al menos 32 caracteres (en Render se genera sola).
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres
# URL pública sin "/" final: define a dónde apuntan los QR (p. ej. https://postea-imago.onrender.com).
BASE_URL=http://localhost:3000
# Render define PORT solo. HOST por defecto 0.0.0.0.
PORT=3000
HOST=
NODE_ENV=development
TZ=America/Bogota

# Admin inicial: se crea al arrancar si no existe (contraseña de 12 caracteres o más). No cambia cuentas existentes.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=

# Opcional: dominios permitidos para autores, separados por comas (p. ej. ucompensar.edu.co).
ALLOWED_EMAIL_DOMAINS=
# true = también los visitantes deben usar esos dominios.
VISITOR_DOMAIN_RESTRICTED=false

# Solo desarrollo, para npm run seed:demo.
DEMO_AUTHOR_PASSWORD=
